FROM node:24-alpine

WORKDIR /app

# `npm ci`, not `npm install`: install exactly admin-ui/package-lock.json (committed) and fail if it
# disagrees with package.json, instead of quietly resolving newer versions at build time. Same rule as
# `uv sync --locked` for the Python side — a committed lock is only worth having if the build obeys it.
COPY admin-ui/package.json admin-ui/package-lock.json ./
RUN npm ci

EXPOSE 5174

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5174"]
