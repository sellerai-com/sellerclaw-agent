# Runtime data (manifest, credentials — never commit secrets).
# Anchored to the repo root on purpose: an unanchored `data/` also swallows every nested data dir,
# which silently un-tracked the test fixtures under tests/unit/bundle/data/ — green locally, red in
# a fresh CI clone.
/data/

# Local secrets
secrets.env

# Developer-only local overrides (see dev.env.example)
dev.env
# Locally built sellerclaw-cli wheel (the dir itself is tracked via .gitkeep)
runtime/.local-wheels/*.whl

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Generated by hatch-vcs at build time (do not commit)
sellerclaw_agent/_version.py

# Dev
.openclaw
.cursor
.claude
AGENTS.md
CLAUDE.md
docs-internal/
tmp/
