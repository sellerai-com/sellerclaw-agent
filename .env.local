# Local profile — docker compose --env-file .env.local
# Details: docs/cli.md

SELLERCLAW_API_URL=http://host.docker.internal:8000
SELLERCLAW_WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174

# Optional (uncomment to override docker-compose / defaults in code)
# SELLERCLAW_EDGE_PING=1
# SELLERCLAW_AGENT_LOG_LEVEL=INFO
# SELLERCLAW_AGENT_LOG_FORMAT=human
# OPENCLAW_GATEWAY_HTTP_BASE=http://127.0.0.1:7789
# OPENCLAW_PORT_GATEWAY=7788
# OPENCLAW_PORT_VNC=6080

# Diagnose media-completion delivery / scope failures: trace surfaces auth
# decisions, scope-clearing, and subagent-announce/direct-fallback choices in
# /home/node/.openclaw/logs/openclaw.log. Revert to debug for normal runs.
OPENCLAW_LOG_LEVEL=trace

# Test against an OpenClaw build pinned to a specific main commit.
# Why not ghcr.io/openclaw/openclaw:main? Upstream rebuilds that tag rarely;
# at time of writing it still resolves to a 2026-03-26 snapshot and crashes
# our container on schema validation. Instead we build openclaw from source
# at a fixed commit SHA and host it under our own GHCR namespace.
#
# To produce one: run either the CI workflow (preferred) or the local script:
#   gh workflow run openclaw-pinned.yml -f commit=<full-sha>           # in CI
#   ./runtime/build-openclaw-pinned.sh <sha> --push                    # local
#
# Currently pinned: PR #84006 (generated-media direct fallback) at 37a9f58d1b.
# OPENCLAW_REPO=ghcr.io/sellerai-com/openclaw-pinned
# OPENCLAW_TAG=pinned-37a9f58d1b
