# Developer-only overrides — copy to `dev.env` (gitignored) and edit.
#
#   cp dev.env.example dev.env
#
# dev.env is read by the Makefile (the developer entrypoint), NOT by ./setup.sh
# (the user entrypoint). It never affects production / CI builds.

# Absolute path to your local sellerclaw-cli source checkout — the directory
# that contains its pyproject.toml (e.g. <sellerclaw repo>/packages/sellerclaw-cli).
#
# When set, `make up-dev` / `make up-stage` / `make up` build the edge image with
# sellerclaw-cli installed from this source instead of PyPI, and `make install`
# links it editable into the host venv too. Comment it out to go back to PyPI.
#
# SELLERCLAW_CLI_LOCAL_PATH=/absolute/path/to/sellerclaw/packages/sellerclaw-cli
