{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sellerclaw.ai/contracts/agent-manifest-v2.json",
  "title": "SellerClaw edge agent manifest (POST /manifest body, v2 generic)",
  "description": "Generic agent manifest. Carries pre-rendered per-agent prompt content (instructions + skills) and LLM/channel wiring. The agent generates the OpenClaw config + workspaces purely from this payload; it no longer reads on-disk templates.",
  "type": "object",
  "additionalProperties": true,
  "required": ["user_id", "llm", "agents"],
  "properties": {
    "user_id": { "type": "string", "format": "uuid" },
    "agent_api_base_path": {
      "type": "string",
      "description": "Path segment appended to `SELLERCLAW_API_URL` to form the agent API base URL (e.g. `/agent`)."
    },
    "proxy_url": { "type": "string" },
    "web_search": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "llm": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text_model", "groups"],
      "properties": {
        "text_model": {
          "type": "object",
          "required": ["primary"],
          "properties": {
            "primary": { "$ref": "#/$defs/modelRef" },
            "secondary": { "$ref": "#/$defs/modelRef" }
          }
        },
        "image_model": { "$ref": "#/$defs/modelChoice" },
        "video_model": { "$ref": "#/$defs/modelChoice" },
        "pdf_model": { "$ref": "#/$defs/modelChoice" },
        "compaction_model": { "$ref": "#/$defs/modelRef" },
        "memory_flush_model": { "$ref": "#/$defs/modelRef" },
        "groups": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/modelGroup" }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": true,
      "required": ["main_agent"],
      "properties": {
        "thinking_default": { "type": "string" },
        "reasoning_default": { "type": "string", "enum": ["on", "off", "stream"] },
        "model_default": { "type": "string" },
        "browser_enabled_default": { "type": "boolean" },
        "image_generation_default": { "type": "boolean" },
        "video_generation_default": { "type": "boolean" },
        "main_agent": { "$ref": "#/$defs/agent" },
        "subagents": { "type": "array", "items": { "$ref": "#/$defs/agent" } }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "primary": { "type": "string" },
        "telegram": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "bot_token": { "type": "string" },
            "allowed_user_ids": { "type": "array", "items": { "type": "string" } },
            "allowed_group_ids": { "type": "array", "items": { "type": "string" } }
          }
        },
        "whatsapp": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "allowed_numbers": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },
  "$defs": {
    "modelRef": {
      "type": "object",
      "required": ["group", "model"],
      "properties": {
        "group": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "modelChoice": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "primary": { "oneOf": [{ "$ref": "#/$defs/modelRef" }, { "type": "null" }] },
        "fallbacks": { "type": "array", "items": { "$ref": "#/$defs/modelRef" } }
      }
    },
    "modelInfo": {
      "type": "object",
      "additionalProperties": true,
      "description": "reasoning/contextWindow/maxTokens are optional; non-frontier models omit them so OpenClaw applies its defaults.",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "reasoning": { "type": "boolean" },
        "input": { "type": "array", "items": { "type": "string" } },
        "contextWindow": { "type": "integer" },
        "maxTokens": { "type": "integer" }
      }
    },
    "modelGroup": {
      "type": "object",
      "additionalProperties": true,
      "required": ["base_url", "api_key", "models"],
      "properties": {
        "base_url": { "type": "string" },
        "api_key": { "type": "string" },
        "model_name_prefix": { "type": "string" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/modelInfo" } }
      }
    },
    "skill": {
      "type": "object",
      "required": ["name", "content"],
      "properties": {
        "name": { "type": "string" },
        "content": { "type": "string" },
        "references": {
          "type": "array",
          "description": "Optional. The skill's references/ subtree, carried verbatim. Each entry is written alongside SKILL.md into the agent workspace at skills/<name>/<path>. Absent or empty when the skill has no reference files.",
          "items": {
            "type": "object",
            "required": ["path", "content"],
            "properties": {
              "path": { "type": "string", "description": "Path relative to the skill directory, e.g. references/data-model.md." },
              "content": { "type": "string" }
            }
          }
        }
      }
    },
    "agentContent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["instructions", "skills"],
      "properties": {
        "instructions": { "type": "string" },
        "soul": { "type": ["string", "null"] },
        "identity": { "type": ["string", "null"] },
        "user_context": { "type": ["string", "null"] },
        "tools_doc": { "type": ["string", "null"] },
        "heartbeat": { "type": ["string", "null"] },
        "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "model", "content"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": "string", "enum": ["primary", "secondary"] },
        "thinking": { "type": ["string", "null"] },
        "browser_enabled": { "type": ["boolean", "null"] },
        "image_generation": { "type": ["boolean", "null"] },
        "video_generation": { "type": ["boolean", "null"] },
        "content": { "$ref": "#/$defs/agentContent" }
      }
    }
  }
}
